<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_welcome"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/content_top_margin"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/welcome_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans"
            android:shadowColor="#66000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:text="@string/welcome_title"
            android:textColor="#FFFFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/enter_button"
            android:layout_width="156dp"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/entry_button_background"
            android:stateListAnimator="@null"
            android:text="@string/entry_label"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/language_selector"
            android:layout_width="200dp"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/language_selector_background"
            android:contentDescription="@string/select_language"
            android:dropDownWidth="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:popupBackground="#FFFFFFFF"
            android:spinnerMode="dropdown" />
    </LinearLayout>
</FrameLayout>
